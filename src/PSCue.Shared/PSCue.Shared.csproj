<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- CommandProcess resolves and launches child processes; its internals are exercised
         directly so resolution and failure handling can be tested on either host. -->
    <InternalsVisibleTo Include="PSCue.ArgumentCompleter.Tests" />
  </ItemGroup>

</Project>